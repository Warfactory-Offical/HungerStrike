{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/hungerstrike",
		"sources": "https://github.com/jaquadro/HungerStrike",
		"issues": "https://github.com/jaquadro/HungerStrike/issues"
	},
	"license": "${mod_license}",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.jaquadro.minecraft.hungerstrike.fabric.HungerStrikeFabric"
		],
		"client": [
			"com.jaquadro.minecraft.hungerstrike.fabric.HungerStrikeFabricClient"
		]
	},
	"mixins": [
		"hungerstrike.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "${fabric_minecraft_version_range}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
